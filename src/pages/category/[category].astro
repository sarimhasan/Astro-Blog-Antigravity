---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { formatPostDate, mapPostEntry, sortPostsByDateDesc } from '../../lib/content';

export const prerender = false;

const { category } = Astro.params;

const CATEGORIES: Record<string, string> = {
  philosophy: 'Philosophy',
  science: 'Science',
  thoughts: 'Thoughts',
  miscellaneous: 'Miscellaneous',
};

const title = category ? CATEGORIES[category as string] || category : 'Category';

const posts = sortPostsByDateDesc(
  (await getCollection('posts'))
    .filter((post) => post.data.category === category)
    .map(mapPostEntry)
);
---

<MainLayout
  title={`${title} — The Inkwell`}
  description={`Browse posts in the ${title.toLowerCase()} category.`}
>
  <section class="fade-in">
    <div class="max-w-3xl">
      <p class="eyebrow">Category archive</p>
      <h1 class="section-heading mt-5 text-[clamp(2.7rem,6vw,4.6rem)] font-semibold tracking-[-0.02em] text-[var(--text)]" data-animate="hero-heading">
        {title}
      </h1>
      <p class="body-copy mt-5 max-w-[48ch]">
        Posts grouped by topic, sorted with the newest entry first.
      </p>
      <a href="/" class="button-primary group mt-8">
        <span>Back to home</span>
        <span aria-hidden="true" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/8">←</span>
      </a>
    </div>

    {posts.length > 0 ? (
      <section class="mt-10 space-y-4">
        {posts.map((post, index) => (
          <article class="surface-shell rounded-[1.5rem] p-3 transition-transform duration-200 hover:-translate-y-0.5" data-scroll-reveal data-hover-card>
            <div class="surface-inner rounded-[1.2rem] p-5 sm:p-6">
              <div class="flex flex-wrap items-center gap-3 text-[0.68rem] uppercase tracking-[0.14em] text-[var(--text-soft)]">
                <span>Entry {String(index + 1).padStart(2, '0')}</span>
                <span class={`chip chip-${category}`}>{title}</span>
                <span>{formatPostDate(post.date)}</span>
              </div>

              <a href={`/${post.slug}`} class="group mt-4 block">
                <h2 class="section-heading max-w-[24ch] text-[clamp(1.35rem,3vw,2rem)] font-medium tracking-[-0.02em] transition-colors duration-200 group-hover:text-[var(--accent)]">
                  {post.title}
                </h2>
                <p class="body-copy mt-3 max-w-[68ch]">{post.excerpt || 'A reflective entry from the journal.'}</p>
              </a>

              <p class="mt-4 text-[0.68rem] uppercase tracking-[0.14em] text-[var(--text-soft)]">
                {post.readTime || '5 min read'}
              </p>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="mt-10 surface-shell rounded-[1.5rem] p-4">
        <div class="surface-inner rounded-[1.2rem] p-6">
          <p class="body-copy">No posts in this category yet.</p>
        </div>
      </section>
    )}
  </section>
</MainLayout>
