---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { formatPostDate, getFeaturedPost, mapPostEntry, sortPostsByDateDesc } from '../lib/content';

const posts        = sortPostsByDateDesc((await getCollection('posts')).map(mapPostEntry));
const featuredPost = getFeaturedPost(posts);
const recentPosts  = posts.slice(0, 3);
const gearPosts    = posts.slice(3, 6);

const intelItems = (await getCollection('intel')).map((item) => ({ slug: item.slug, ...item.data }));

// Entry count label (pad to 3 digits)
const entryCount = String(posts.length).padStart(3, '0');

const CATEGORIES: Record<string, string> = {
  philosophy:    'Philosophy',
  science:       'Science',
  thoughts:      'Thoughts',
  miscellaneous: 'Miscellaneous',
};
---

<MainLayout
  title="The Inkwell"
  description="Thoughts written in graphite, stored in silicon. A personal journal for essays, philosophy, and reflections."
>

  <!-- ══════════════════════════════════════════════════
       SECTION 1 — HERO
  ═══════════════════════════════════════════════════ -->
  <section class="flex flex-col gap-6 py-16 md:py-24 max-w-[720px] px-6 lg:px-10">
    <h1 class="font-['Courier_Prime'] text-[clamp(2.4rem,7vw,3.2rem)] font-bold leading-[1.1] tracking-[-0.02em] text-[var(--primary)]">
      Thoughts written in graphite, stored in silicon.
    </h1>
    <p class="font-['Source_Serif_4'] text-[1.15rem] leading-relaxed text-[var(--on-surface-variant)] max-w-[600px]">
      A digital manifestation of late-night musings, technical discoveries,
      and personal reflections. Welcome to the quiet corner of my mind.
    </p>
    <svg class="w-32 h-4 text-[var(--outline)]" preserveAspectRatio="none" viewBox="0 0 100 10">
      <path class="sketch-divider" d="M0,5 Q25,0 50,5 T100,5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path>
    </svg>
  </section>


  <!-- ══════════════════════════════════════════════════
       SECTION 2 — FEATURED POST
  ═══════════════════════════════════════════════════ -->
  <section class="paper-card p-6 md:p-10 paper-shadow mx-6 lg:mx-10 flex flex-col md:flex-row gap-8 items-start rounded-[0.25rem]">
    <!-- Cover image -->
    <div class="w-full md:w-1/2 aspect-[4/3] bg-[var(--surface-container-high)] relative overflow-hidden rounded-[0.25rem]">
      {featuredPost?.coverImage ? (
        <img
          src={featuredPost.coverImage}
          alt={featuredPost.title}
          class="object-cover w-full h-full mix-blend-multiply opacity-90"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[var(--surface-container)]">
          <span class="font-['Courier_Prime'] text-[0.75rem] uppercase tracking-[0.1em] text-[var(--outline)]">No cover image</span>
        </div>
      )}
    </div>

    <!-- Info -->
    <div class="w-full md:w-1/2 flex flex-col gap-4">
      <div class="flex gap-2 items-center flex-wrap">
        <span class="px-2 py-1 font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.05em] chip-philosophy">
          {featuredPost ? (CATEGORIES[featuredPost.category] || featuredPost.category) : 'Journal'}
        </span>
        <span class="font-['Source_Serif_4'] text-[0.82rem] text-[var(--outline)]">
          {featuredPost ? formatPostDate(featuredPost.date) : 'No date'}
        </span>
      </div>

      <h2 class="font-['Courier_Prime'] text-[clamp(1.5rem,4vw,2rem)] font-bold leading-[1.2] text-[var(--primary)]">
        {featuredPost?.title || 'No featured post yet'}
      </h2>

      <p class="font-['Source_Serif_4'] text-[1rem] leading-[1.6] text-[var(--on-surface-variant)] line-clamp-3">
        {featuredPost?.excerpt || 'Flag a post with featured: true to surface it here.'}
      </p>

      {featuredPost && (
        <a
          href={`/${featuredPost.slug}`}
          class="inline-flex items-center gap-2 font-['Courier_Prime'] text-[0.78rem] uppercase tracking-[0.05em] text-[var(--primary)] mt-2 ink-link"
        >
          Read Entry <span class="text-sm">→</span>
        </a>
      )}
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════
       SECTION 3 — RECENT ENTRIES + REVIEWS SIDEBAR
  ═══════════════════════════════════════════════════ -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-12 px-6 lg:px-10 items-start">

    <!-- Latest Entries Column -->
    <section class="lg:col-span-7 flex flex-col gap-6">
      <h3 class="font-['Courier_Prime'] text-[1.15rem] font-bold text-[var(--primary)] border-b-2 border-[var(--primary)] pb-2 inline-block">
        Recent Entries
      </h3>

      <div class="flex flex-col gap-8">
        {recentPosts.map((post) => (
          <article class="group cursor-pointer">
            <a href={`/${post.slug}`} class="block">
              <div class="flex gap-3 items-baseline">
                <span class="font-['Source_Serif_4'] text-[0.82rem] text-[var(--outline)] w-24 shrink-0">
                  {formatPostDate(post.date)}
                </span>
                <h4 class="font-['Courier_Prime'] text-[1.15rem] font-bold text-[var(--on-surface)] group-hover:text-[var(--primary)] transition-colors">
                  {post.title}
                </h4>
              </div>
              <div class="pl-[108px] mt-1">
                <p class="font-['Source_Serif_4'] text-[0.95rem] leading-[1.6] text-[var(--on-surface-variant)] line-clamp-2">
                  {post.excerpt || 'A reflective entry from the journal.'}
                </p>
                <div class="flex gap-2 mt-2">
                  <span class={`px-2 py-0.5 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] chip-${post.category}`}>
                    {CATEGORIES[post.category] || post.category}
                  </span>
                  {post.featured && (
                    <span class="px-2 py-0.5 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] bg-[rgba(209,228,251,0.3)] text-[var(--on-primary-fixed)]">
                      Featured
                    </span>
                  )}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-4 flex justify-center">
        <a
          href="/journal"
          class="bg-[var(--primary)] text-[var(--on-primary)] font-['Courier_Prime'] text-[0.78rem] uppercase tracking-[0.05em] px-6 py-2.5 paper-shadow btn-paper rounded-[0.25rem] inline-block"
        >
          View Archives
        </a>
      </div>
    </section>

    <!-- Reviews Sidebar -->
    <aside class="lg:col-span-5 flex flex-col gap-6 bg-[var(--surface-container-low)] p-6 paper-shadow relative rounded-[0.25rem]">
      <!-- Sticky note accent -->
      <div class="absolute -top-3 -right-3 w-10 h-10 sticky-note shadow-sm transform rotate-12 flex items-center justify-center rounded-[0.125rem]">
        <span class="text-[var(--outline)] text-sm">📌</span>
      </div>

      <h3 class="font-['Courier_Prime'] text-[1.15rem] font-bold text-[var(--primary)] border-b border-[var(--outline-variant)] pb-2">
        Reviews Preview
      </h3>

      <div class="flex flex-col gap-5">
        {intelItems.length > 0 ? (
          intelItems.map((entry: any) => (
            <div class="flex gap-3 items-start">
              <div class="w-12 h-14 bg-[var(--surface-container-high)] shrink-0 overflow-hidden rounded-[0.125rem] flex items-center justify-center">
                {entry.coverImage ? (
                  <img src={entry.coverImage} alt={entry.title} class="object-cover w-full h-full mix-blend-multiply opacity-80" />
                ) : (
                  <span class="font-['Courier_Prime'] text-[0.6rem] text-[var(--outline)]">
                    {entry.itemType === 'book' ? '📖' : '🎬'}
                  </span>
                )}
              </div>
              <div class="flex flex-col">
                <span class="font-['Source_Serif_4'] text-[0.95rem] text-[var(--on-surface)]">{entry.title}</span>
                <span class="font-['Source_Serif_4'] text-[0.78rem] text-[var(--outline)]">
                  {entry.creator || 'Unknown'} • {entry.rating || 'N/A'}
                </span>
              </div>
            </div>
          ))
        ) : (
          <p class="font-['Source_Serif_4'] text-[0.88rem] text-[var(--on-surface-variant)]">
            No intel entries yet. Add items to the intel collection.
          </p>
        )}
      </div>
    </aside>
  </div>


  <!-- ══════════════════════════════════════════════════
       SECTION 4 — FIELD INVENTORY (Additional Posts)
  ═══════════════════════════════════════════════════ -->
  {gearPosts.length > 0 && (
    <section class="mt-16 px-6 lg:px-10">
      <div class="flex items-baseline justify-between gap-4 mb-8">
        <h3 class="font-['Courier_Prime'] text-[1.15rem] font-bold text-[var(--primary)]">
          More From the Archive
        </h3>
        <div class="h-px flex-grow bg-[var(--outline-variant)]"></div>
        <span class="font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.05em] text-[var(--outline)] shrink-0">
          Entries: {entryCount}
        </span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {gearPosts.map((post) => (
          <a
            href={`/${post.slug}`}
            class="group paper-card paper-shadow overflow-hidden rounded-[0.25rem] transition-all hover:shadow-lg"
          >
            <!-- Cover image -->
            <div class="relative h-44 overflow-hidden bg-[var(--surface-container)]">
              {post.coverImage ? (
                <img
                  src={post.coverImage}
                  alt={post.title}
                  class="h-full w-full object-cover opacity-90 transition duration-300 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center">
                  <span class="font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.1em] text-[var(--outline)]">No image</span>
                </div>
              )}
            </div>

            <!-- Card body -->
            <div class="p-4">
              <div class="flex items-center justify-between gap-3 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] text-[var(--outline)]">
                <span>{CATEGORIES[post.category] || post.category}</span>
                <span>{formatPostDate(post.date)}</span>
              </div>
              <h4 class="mt-3 font-['Courier_Prime'] text-[1.05rem] font-bold leading-[1.2] text-[var(--on-surface)] transition group-hover:text-[var(--primary)]">
                {post.title}
              </h4>
              <p class="mt-2 font-['Source_Serif_4'] text-[0.88rem] leading-[1.5] text-[var(--on-surface-variant)] line-clamp-2">
                {post.excerpt || 'An entry from the journal archive.'}
              </p>
              <div class="mt-4 flex items-center justify-between font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] text-[var(--outline)]">
                <span>{post.readTime || '5 MIN READ'}</span>
                <span class="text-[var(--primary)] ink-link">Read →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

</MainLayout>