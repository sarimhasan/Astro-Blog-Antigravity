---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { formatPostDate, mapPostEntry, sortPostsByDateDesc } from '../lib/content';

const CATEGORIES: Record<string, string> = {
  philosophy: 'Philosophy',
  science:    'Science',
  thoughts:   'Thoughts',
  miscellaneous: 'Miscellaneous',
};

const posts = sortPostsByDateDesc((await getCollection('posts')).map(mapPostEntry));
---

<MainLayout
  title="Journal — The Inkwell"
  description="Browse the full archive of posts from The Inkwell, sorted by most recent."
>
  <main class="mx-auto w-full max-w-[1200px] px-6 pb-16 lg:px-10">

    <!-- Page header -->
    <section class="border-b border-[var(--outline-variant)] py-14">
      <p class="font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.1em] text-[var(--outline)]">
        Archive
      </p>
      <h1 class="mt-3 font-['Courier_Prime'] text-[clamp(2.4rem,7vw,4rem)] font-bold leading-[1.05] tracking-[-0.02em] text-[var(--primary)]">
        Journal
      </h1>
      <p class="mt-4 max-w-[40rem] font-['Source_Serif_4'] text-[1.05rem] leading-[1.6] text-[var(--on-surface-variant)]">
        Every post in chronological order, with the newest entry first. Ordering is
        driven by each post's date metadata.
      </p>
    </section>

    <!-- Post list -->
    <section class="mt-8">
      {posts.map((post, index) => (
        <article class="group relative border-b border-[var(--outline-variant)]/40 py-8 transition-all duration-200 hover:bg-[rgba(22,40,57,0.02)]">

          <!-- Meta -->
          <div class="mb-3 flex flex-wrap items-baseline gap-4">
            <span class="font-['Courier_Prime'] text-[0.72rem] uppercase text-[var(--outline)]">
              Entry {String(index + 1).padStart(3, '0')}
            </span>
            <span class={`px-2 py-0.5 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] chip-${post.category}`}>
              {CATEGORIES[post.category] || 'General'}
            </span>
            {post.featured && (
              <span class="px-2 py-0.5 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] bg-[rgba(209,228,251,0.3)] text-[var(--on-primary-fixed)]">
                Featured
              </span>
            )}
            <span class="font-['Source_Serif_4'] text-[0.82rem] text-[var(--outline)]">
              {formatPostDate(post.date)}
            </span>
          </div>

          <!-- Title + excerpt -->
          <a href={`/${post.slug}`} class="block">
            <h2 class="max-w-[28ch] font-['Courier_Prime'] text-[clamp(1.4rem,3vw,1.8rem)] font-bold leading-[1.15] text-[var(--on-surface)] transition-colors group-hover:text-[var(--primary)]">
              {post.title}
            </h2>
            <p class="mt-3 max-w-[56rem] font-['Source_Serif_4'] text-[1rem] leading-[1.6] text-[var(--on-surface-variant)]">
              {post.excerpt || 'A reflective entry from the journal.'}
            </p>
          </a>

          <!-- Read time -->
          <p class="mt-4 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] text-[var(--outline)]">
            {post.readTime || '5 MIN READ'}
          </p>
        </article>
      ))}

      {posts.length === 0 && (
        <div class="paper-card paper-shadow p-10 mt-4 rounded-[0.25rem]">
          <p class="font-['Courier_Prime'] text-[0.82rem] uppercase tracking-[0.05em] text-[var(--on-surface-variant)]">
            No posts in the archive yet.
          </p>
        </div>
      )}
    </section>

  </main>
</MainLayout>