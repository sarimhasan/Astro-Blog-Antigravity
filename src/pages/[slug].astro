---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';
import { formatPostDate } from '../lib/content';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const post = await getEntry('posts', slug);

if (!post) {
  return Astro.redirect('/');
}

const { Content } = await post.render();

const CATEGORIES: Record<string, string> = {
  philosophy: 'Philosophy',
  science: 'Science',
  thoughts: 'Thoughts',
  miscellaneous: 'Miscellaneous',
};

const categoryName = CATEGORIES[post.data.category] || 'General';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  image: post.data.coverImage ? [new URL(post.data.coverImage, Astro.url).href] : [],
  datePublished: post.data.date,
  author: [
    {
      '@type': 'Person',
      name: post.data.authorName,
      url: Astro.url.origin,
    },
  ],
};
---

<MainLayout
  title={`${post.data.title} — The Inkwell`}
  description={post.data.excerpt}
  image={post.data.coverImage}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <section class="fade-in">
    <a href="/" class="button-primary group">
      <span>Back to home</span>
      <span aria-hidden="true" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/8">←</span>
    </a>

    <article class="surface-shell mt-6 rounded-[1.75rem] p-4">
      <div class="surface-inner rounded-[1.5rem] overflow-hidden">
        <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
          <div class="p-6 sm:p-8 lg:p-10">
            <div class="flex flex-wrap items-center gap-2 text-[0.68rem] uppercase tracking-[0.18em] text-[var(--text-soft)]">
              <span class={`chip chip-${post.data.category}`}>{categoryName}</span>
              {post.data.featured && <span class="chip border-[rgba(201,154,86,0.28)] bg-[rgba(201,154,86,0.12)] text-[var(--accent-strong)]">Featured</span>}
              <span>{formatPostDate(post.data.date)}</span>
              <span>{post.data.readTime}</span>
            </div>

            <h1 class="section-heading mt-6 max-w-[15ch] text-[clamp(2.5rem,5.5vw,4.4rem)] font-semibold tracking-[-0.02em] text-[var(--text)]" data-animate-text>
              {post.data.title}
            </h1>

            <p class="body-copy mt-6 max-w-[58ch]">
              {post.data.excerpt || 'A reflective entry from the archive.'}
            </p>

            <p class="mt-8 text-[0.72rem] uppercase tracking-[0.16em] text-[var(--text-soft)]">
              Written by <span class="text-[var(--text-muted)]">{post.data.authorName}</span>
            </p>
          </div>

          <div class="relative border-t border-[var(--border)] bg-black/20 lg:border-l lg:border-t-0">
            {post.data.coverImage ? (
              <img
                src={post.data.coverImage}
                alt={post.data.title}
                class="h-full min-h-[20rem] w-full object-cover"
              />
            ) : (
              <div class="flex min-h-[20rem] items-center justify-center px-8 text-center text-[0.72rem] uppercase tracking-[0.22em] text-[var(--text-soft)]">
                No image attached
              </div>
            )}
          </div>
        </div>
      </div>
    </article>

    <section class="mt-6 grid gap-6 lg:grid-cols-[260px_minmax(0,1fr)]">
      <aside class="surface-shell self-start rounded-[1.5rem] p-4">
        <div class="surface-inner rounded-[1.2rem] p-5">
          <p class="eyebrow">Entry details</p>
          <div class="mt-5 space-y-4 text-[0.76rem] uppercase tracking-[0.18em] text-[var(--text-soft)]">
            <div>
              <div class="text-[0.68rem] text-[var(--text-soft)]">Category</div>
              <div class="mt-1 text-[0.88rem] text-[var(--text)]">{categoryName}</div>
            </div>
            <div>
              <div class="text-[0.68rem] text-[var(--text-soft)]">Read time</div>
              <div class="mt-1 text-[0.88rem] text-[var(--text)]">{post.data.readTime}</div>
            </div>
            <div>
              <div class="text-[0.68rem] text-[var(--text-soft)]">Author</div>
              <div class="mt-1 text-[0.88rem] text-[var(--text)]">{post.data.authorName}</div>
            </div>
            <div>
              <div class="text-[0.68rem] text-[var(--text-soft)]">Published</div>
              <div class="mt-1 text-[0.88rem] text-[var(--text)]">{formatPostDate(post.data.date)}</div>
            </div>
          </div>
        </div>
      </aside>

      <div class="surface-shell rounded-[1.5rem] p-4">
        <div class="surface-inner rounded-[1.2rem] p-6 sm:p-8 lg:p-10" data-scroll-reveal>
          <div class="article-prose max-w-none">
            <Content />
          </div>
        </div>
      </div>
    </section>
  </section>
</MainLayout>
