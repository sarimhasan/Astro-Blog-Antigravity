---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';
import { formatPostDate } from '../lib/content';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const post = await getEntry('posts', slug);

if (!post) {
  return Astro.redirect('/');
}

const { Content } = await post.render();

const CATEGORIES: Record<string, string> = {
  philosophy:    'Philosophy',
  science:       'Science',
  thoughts:      'Thoughts',
  miscellaneous: 'Miscellaneous',
};

const categoryName = CATEGORIES[post.data.category] || 'General';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  image: post.data.coverImage ? [new URL(post.data.coverImage, Astro.url).href] : [],
  datePublished: post.data.date,
  author: [
    {
      '@type': 'Person',
      name: post.data.authorName,
      url: Astro.url.origin,
    },
  ],
};
---

<MainLayout
  title={`${post.data.title} — Karachi And Beyond`}
  description={post.data.excerpt}
  image={post.data.coverImage}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <main class="mx-auto w-full max-w-[1200px] px-6 pb-16 lg:px-10">

    <!-- Back link -->
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-3 border border-[var(--outline-variant)] px-4 py-3 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.22em] text-[var(--primary)] transition hover:bg-[var(--surface-container-high)]"
    >
      <span>←</span>
      <span>Back to logs</span>
    </a>

    <!-- Post hero card -->
    <article class="mt-6 border border-[var(--outline-variant)] bg-[var(--surface-container-low)]">
      <div class="grid gap-0 lg:grid-cols-[1.1fr_0.9fr]">

        <!-- Left: metadata + title -->
        <div class="border-b border-[var(--outline-variant)] p-8 sm:p-10 lg:border-b-0 lg:border-r lg:border-[var(--outline-variant)]">
          <!-- Tag strip -->
          <div class="flex flex-wrap items-center gap-2 font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.1em]">
            <span class={`px-2.5 py-1 text-[var(--primary)] chip-${post.data.category}`}>
              {categoryName}
            </span>
            {post.data.featured && (
              <span class="px-2.5 py-1 bg-[rgba(209,228,251,0.3)] text-[var(--on-primary-fixed)]">
                Featured
              </span>
            )}
            <span class="text-[var(--on-surface-variant)]">{formatPostDate(post.data.date)}</span>
            <span class="text-[var(--on-surface-variant)]">{post.data.readTime}</span>
          </div>

          <!-- Title -->
          <h1 class="mt-6 max-w-[18ch] font-['Courier_Prime'] text-[clamp(2.4rem,6vw,4rem)] font-bold uppercase leading-[1.05] tracking-[-0.02em] text-[var(--primary)]">
            {post.data.title}
          </h1>

          <!-- Excerpt -->
          <p class="mt-5 max-w-[42rem] font-['Source_Serif_4'] text-[1.05rem] leading-[1.6] text-[var(--on-surface-variant)]">
            {post.data.excerpt || 'A reflective entry from the field terminal.'}
          </p>

          <!-- Author + year badges -->
          <div class="mt-8 flex flex-wrap gap-2 font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.1em]">
            <span class="border border-[var(--outline-variant)] px-2.5 py-1 text-[var(--primary)] bg-[var(--surface-container-high)]">
              {post.data.authorName}
            </span>
            <span class="border border-[var(--outline-variant)] px-2.5 py-1 text-[var(--secondary)] bg-[var(--surface-container-high)]">
              Issue {new Date(post.data.date).getFullYear()}
            </span>
          </div>
        </div>

        <!-- Right: cover image -->
        <div class="relative bg-[var(--surface-container)] flex items-center justify-center overflow-hidden">
          {post.data.coverImage ? (
            <img
              src={post.data.coverImage}
              alt={post.data.title}
              class="h-full min-h-[22rem] w-full object-cover"
            />
          ) : (
            <div class="flex min-h-[22rem] items-center justify-center font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.2em] text-[var(--outline)]">
              No image attached
            </div>
          )}
        </div>
      </div>
    </article>

    <!-- Content + telemetry sidebar -->
    <section class="mt-4 grid gap-4 lg:grid-cols-[260px_minmax(0,1fr)]">

      <!-- Sidebar -->
      <aside class="border border-[var(--outline-variant)] bg-[var(--surface-container-low)] p-6 self-start">
        <p class="font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.1em] text-[var(--primary)] border-b border-[var(--outline-variant)] pb-2 mb-4">
          Entry Details
        </p>
        <div class="space-y-4 font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.05em] text-[var(--on-surface-variant)]">
          <div>
            <span class="text-[var(--outline)] text-[0.68rem]">Category</span>
            <div class="mt-1 font-bold text-[var(--primary)]">{categoryName}</div>
          </div>
          <div>
            <span class="text-[var(--outline)] text-[0.68rem]">Read time</span>
            <div class="mt-1 font-bold text-[var(--primary)]">{post.data.readTime}</div>
          </div>
          <div>
            <span class="text-[var(--outline)] text-[0.68rem]">Author</span>
            <div class="mt-1 font-bold text-[var(--primary)]">{post.data.authorName}</div>
          </div>
          <div>
            <span class="text-[var(--outline)] text-[0.68rem]">Published</span>
            <div class="mt-1 font-bold text-[var(--primary)]">{formatPostDate(post.data.date)}</div>
          </div>
        </div>
      </aside>

      <!-- Prose content -->
      <div class="border border-[var(--outline-variant)] bg-[var(--surface-container-low)] p-6 sm:p-8 lg:p-10">
        <div class="prose-journal max-w-none">
          <Content />
        </div>
      </div>

    </section>
  </main>
</MainLayout>