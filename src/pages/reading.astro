---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import DispersionMark from '../components/DispersionMark.astro';

export const prerender = false;

const entries = await getCollection('intel');

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await entry.render();
    return { slug: entry.slug, Content, ...entry.data };
  })
);

// In-progress first, then finished; alphabetical inside each group.
const order = { 'in-progress': 0, complete: 1 } as const;
items.sort(
  (a, b) => order[a.status] - order[b.status] || a.title.localeCompare(b.title)
);

const inProgress = items.filter((i) => i.status === 'in-progress');
const books = items.filter((i) => i.itemType === 'book').length;
const films = items.filter((i) => i.itemType === 'movie').length;

const filters = [
  { key: 'all', label: 'Everything', count: items.length },
  { key: 'book', label: 'Books', count: books },
  { key: 'movie', label: 'Films', count: films },
  { key: 'in-progress', label: 'In progress', count: inProgress.length }
];
---

<MainLayout
  page="reading"
  title="Reading — Sarim Hasan"
  description="Books and films I am in the middle of or have just finished, with the notes I took along the way."
>
  <section class="rd-head">
    <div class="rd-head__wash" aria-hidden="true"></div>
    <div class="shell rd-head__inner">
      <h1 class="display display-xl rd-head__title" data-split-lines>Reading</h1>

      <div class="rd-head__lead">
        <p class="lede" data-reveal>
          Everything I am in the middle of, and the things I have just put down. The notes are the
          ones I wrote for myself, so they are shorter and ruder than a review.
        </p>
        <div class="rd-head__stats" data-reveal>
          <span class="readout" data-scramble>{books} {books === 1 ? 'book' : 'books'}</span>
          <span class="readout" data-scramble>{films} {films === 1 ? 'film' : 'films'}</span>
        </div>
      </div>
    </div>
  </section>

  {
    items.length > 0 ? (
      <>
        {/* The shelf: covers you can throw sideways. */}
        {inProgress.length > 0 && (
          <section class="shelf" aria-labelledby="shelf-title">
            <div class="shell shelf__head">
              <h2 id="shelf-title" class="display display-md">On the go</h2>
              <span class="readout shelf__hint">Drag to browse</span>
            </div>

            <div class="shelf__viewport shell-inset" data-shelf>
              <div class="shelf__track" data-shelf-track>
                {inProgress.map((item) => (
                  <a href={`#${item.slug}`} class="shelf__item group">
                    <div class:list={['frame', 'shelf__frame', { 'frame-empty': !item.coverImage }]}>
                      {item.coverImage ? (
                        <img src={item.coverImage} alt="" loading="lazy" decoding="async" />
                      ) : (
                        <span class="shelf__glyph" aria-hidden="true">
                          <Icon name={item.itemType === 'movie' ? 'film' : 'book'} size={30} strokeWidth={1.3} />
                        </span>
                      )}
                    </div>
                    <span class="shelf__title">{item.title}</span>
                    <span class="readout">{item.creator || 'Unknown'}</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        <section class="shell rd-list" aria-labelledby="log-title">
          <div class="rd-list__head">
            <h2 id="log-title" class="display display-md">The log</h2>

            <div class="rd-list__filters" role="group" aria-label="Filter the log">
              {filters.map((f) => (
                <button
                  type="button"
                  class:list={['chip', 'chip-plain', { 'chip-solid': f.key === 'all' }]}
                  data-filter={f.key}
                  aria-pressed={f.key === 'all' ? 'true' : 'false'}
                >
                  {f.label} <span class="rd-list__count">{f.count}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="rd-grid" data-reveal-children>
            {items.map((item) => (
              <article
                class="entry"
                id={item.slug}
                data-intel-item
                data-type={item.itemType}
                data-status={item.status}
                data-lift
              >
                <div class:list={['frame', 'entry__frame', { 'frame-empty': !item.coverImage }]}>
                  {item.coverImage ? (
                    <img src={item.coverImage} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="shelf__glyph" aria-hidden="true">
                      <Icon name={item.itemType === 'movie' ? 'film' : 'book'} size={26} strokeWidth={1.3} />
                    </span>
                  )}
                </div>

                <div class="entry__body">
                  <div class="entry__meta">
                    <span class="readout entry__kind">
                      {item.itemType === 'movie' ? 'Film' : 'Book'}
                    </span>
                    <span
                      class:list={['entry__status', { 'is-live': item.status === 'in-progress' }]}
                    >
                      {item.status === 'in-progress' ? 'Reading now' : 'Finished'}
                    </span>
                  </div>

                  <h3 class="display display-sm entry__title">{item.title}</h3>
                  <p class="readout entry__creator">
                    {item.creator || 'Unknown'} · {item.rating || 'N/A'}
                  </p>

                  {item.excerpt && <p class="copy entry__excerpt">{item.excerpt}</p>}

                  <div class="entry__notes prose">
                    <item.Content />
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="void" data-filter-empty hidden>
            <p class="display display-sm">Nothing in that filter yet.</p>
          </div>
        </section>
      </>
    ) : (
      <section class="shell">
        <div class="void" data-reveal>
          <div class="void__text">
            <p class="display display-md void__line">The shelf is real. The log is new.</p>
            <p class="copy void__copy">
              Books and films will appear here as I read and watch them, along with whatever I
              scribbled in the margins. Nothing is logged yet — I have been writing instead.
            </p>
            <a href="/" class="btn btn-ghost void__cta">
              Read something instead
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <DispersionMark class="void__mark" />
        </div>
      </section>
    )
  }
</MainLayout>

<style>
  /* --------------------------------------------------------------- head */

  .rd-head {
    position: relative;
    padding-block: 10rem 3rem;
    isolation: isolate;
  }

  @media (min-width: 900px) {
    .rd-head {
      padding-block: 12rem 4rem;
    }
  }

  /* No single category owns this page, so it opens on the whole spectrum. */
  .rd-head::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--spectrum);
  }

  .rd-head__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(58% 90% at 12% 0%, var(--cat-philosophy-soft), transparent 70%),
      radial-gradient(58% 90% at 88% 4%, var(--cat-thoughts-soft), transparent 70%);
  }

  .rd-head__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .rd-head__lead {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 800px) {
    .rd-head__lead {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 3rem;
    }
  }

  .rd-head__stats {
    display: flex;
    gap: 1.5rem;
  }

  /* -------------------------------------------------------------- shelf */

  .shelf {
    padding-block: 2rem 4rem;
  }

  .shelf__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .shelf__viewport {
    overflow: hidden;
    cursor: grab;
  }

  .shelf__viewport.is-dragging {
    cursor: grabbing;
  }

  .shelf__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    will-change: transform;
  }

  .shelf__item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 11rem;
  }

  .shelf__frame {
    aspect-ratio: 2 / 3;
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-low);
  }

  .shelf__glyph {
    color: var(--hue-ink);
    opacity: 0.7;
  }

  .shelf__title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
    line-height: 1.25;
  }

  .shelf__hint {
    color: var(--text-soft);
  }

  /* ---------------------------------------------------------- the log */

  .rd-list {
    padding-block: 1rem 3rem;
  }

  .rd-list__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .rd-list__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rd-list__count {
    opacity: 0.6;
  }

  .rd-grid {
    display: grid;
    gap: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--border);
    border-radius: var(--r-md);
  }

  @media (min-width: 720px) {
    .entry {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 2.5rem;
      padding-block: 2.5rem;
    }
  }

  .entry__frame {
    aspect-ratio: 2 / 3;
    border-radius: var(--r-sm);
    display: grid;
    place-items: center;
    align-self: start;
  }

  .entry__body {
    min-width: 0;
  }

  .entry__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .entry__status {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-soft);
  }

  /* A live indicator for the things actually in hand right now. */
  .entry__status.is-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--cat-science-ink);
  }

  .entry__status.is-live::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 99px;
    background: var(--cat-science);
    box-shadow: 0 0 8px var(--cat-science-glow);
  }

  .entry__title {
    color: var(--text);
  }

  .entry__creator {
    margin-top: 0.5rem;
  }

  .entry__excerpt {
    margin-top: 0.9rem;
    max-width: 56ch;
  }

  /* Notes are set at a smaller measure than an essay — they are marginalia,
     not articles. */
  .entry__notes {
    --measure: 58ch;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }

  .entry__notes :global(> *) {
    margin-inline: 0;
  }

  .entry__notes :global(> p:first-of-type::first-letter) {
    float: none;
    font-size: inherit;
    font-family: inherit;
    line-height: inherit;
    padding: 0;
    color: inherit;
    font-weight: inherit;
  }

  .entry__notes :global(> h2),
  .entry__notes :global(> h3) {
    margin-block: 1.4em 0.5em;
  }

  /* ------------------------------------------------------- empty state */

  .void {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 3rem 5rem;
  }

  @media (min-width: 880px) {
    .void {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4rem;
      padding-block: 2rem 7rem;
    }
  }

  .void__line {
    color: var(--text);
    max-width: 16ch;
  }

  .void__copy {
    margin-top: 1.25rem;
    max-width: 46ch;
  }

  .void__cta {
    margin-top: 2rem;
  }

  .void__mark {
    max-width: 34rem;
    margin-inline: auto;
  }
</style>
