---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Philosophy', href: '/category/philosophy', category: 'philosophy' },
  { label: 'Science', href: '/category/science', category: 'science' },
  { label: 'Thoughts', href: '/category/thoughts', category: 'thoughts' },
  { label: 'Miscellaneous', href: '/category/miscellaneous', category: 'miscellaneous' },
];

const isActive = (href: string) => {
  return currentPath.startsWith(href);
};
---

<div class="surface-shell mb-6 rounded-[1.75rem] p-3 backdrop-blur-xl lg:hidden">
  <div class="surface-inner rounded-[1.35rem] p-4">
    <p class="eyebrow">Navigation</p>
    <nav class="mt-3 flex gap-2 overflow-x-auto pb-1" aria-label="Primary navigation mobile">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={[
          `chip chip-${item.category} shrink-0 px-4 py-2.5 transition-colors`,
          isActive(item.href) && 'font-medium ring-1 ring-white/10',
        ]}
      >
        {item.label}
      </a>
    ))}
    </nav>
  </div>
</div>

<aside class="surface-shell relative hidden overflow-hidden rounded-[1.75rem] px-5 py-7 lg:sticky lg:top-4 lg:block lg:min-h-[calc(100vh-2rem)]">
  <div class="surface-inner relative z-10 rounded-[1.35rem] p-5">
    <p class="eyebrow">Navigation</p>

    <nav class="mt-4 flex flex-col gap-3" aria-label="Primary navigation desktop">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            `chip chip-${item.category} justify-between px-4 py-3 transition-colors`,
            isActive(item.href) && 'font-medium ring-1 ring-white/10',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

  </div>
  </div>
</aside>
