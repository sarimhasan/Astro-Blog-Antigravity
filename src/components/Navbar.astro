---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Home',          href: '/' },
  { label: 'Philosophy',    href: '/category/philosophy' },
  { label: 'Science',       href: '/category/science' },
  { label: 'Thoughts',      href: '/category/thoughts' },
  { label: 'Miscellaneous', href: '/category/miscellaneous' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath.startsWith('/blog/');
  return currentPath.startsWith(href);
};
---

<header class="fixed inset-x-0 top-0 z-40 px-4 pt-4 sm:px-6 lg:px-8">
  <div class="mx-auto flex w-full max-w-[1240px] items-center justify-between rounded-full border border-[var(--border)] bg-[rgba(10,13,19,0.74)] px-4 py-3 shadow-[0_24px_80px_rgba(3,7,16,0.35)] backdrop-blur-2xl sm:px-5">
    <a href="/" class="group flex items-center gap-3 shrink-0">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border)] bg-[rgba(255,255,255,0.03)] text-[0.75rem] font-semibold tracking-[0.18em] text-[var(--accent)]">I</span>
      <span class="font-medium tracking-[-0.03em] text-[0.98rem] text-[var(--text)] sm:text-[1rem]">The Inkwell</span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-2 lg:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-2 text-[0.72rem] font-medium uppercase tracking-[0.18em] transition-all duration-200',
            isActive(item.href)
              ? 'bg-[rgba(201,154,86,0.14)] text-[var(--text)] ring-1 ring-[rgba(201,154,86,0.22)]'
              : 'text-[var(--text-muted)] hover:bg-white/5 hover:text-[var(--text)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      id="nav-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      class="group relative flex h-11 w-11 items-center justify-center rounded-full border border-[var(--border)] bg-white/5 text-[var(--text)] transition-transform duration-200 active:scale-95 lg:hidden"
    >
      <span class="sr-only">Menu</span>
      <span id="ham-top" class="absolute h-[1.5px] w-5 -translate-y-1.5 rounded-full bg-current transition-all duration-300"></span>
      <span id="ham-mid" class="absolute h-[1.5px] w-5 rounded-full bg-current transition-all duration-300"></span>
      <span id="ham-bot" class="absolute h-[1.5px] w-3 translate-y-1.5 rounded-full bg-current transition-all duration-300"></span>
    </button>
  </div>

  <div id="mobile-menu" class="pointer-events-none invisible absolute left-4 right-4 top-[5.5rem] z-40 rounded-[1.5rem] border border-[var(--border)] bg-[rgba(10,13,19,0.92)] p-3 opacity-0 shadow-[0_24px_80px_rgba(3,7,16,0.55)] backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <nav aria-label="Mobile navigation" class="grid gap-2">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-[1rem] border border-transparent px-4 py-4 text-[0.75rem] font-medium uppercase tracking-[0.18em] transition-all duration-200',
            `mobile-item mobile-item-${index + 1}`,
            isActive(item.href)
              ? 'border-[rgba(201,154,86,0.2)] bg-[rgba(201,154,86,0.1)] text-[var(--text)]'
              : 'text-[var(--text-muted)] hover:bg-white/5 hover:text-[var(--text)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('mobile-menu');
  const hamTop = document.getElementById('ham-top');
  const hamMid = document.getElementById('ham-mid');
  const hamBot = document.getElementById('ham-bot');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('opacity-0') === false;
    toggle.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('pointer-events-none', !open);
    menu?.classList.toggle('invisible', !open);
    if (open) {
      hamTop?.classList.add('translate-y-0', 'rotate-45');
      hamMid?.classList.add('opacity-0', 'scale-x-0');
      hamBot?.classList.add('translate-y-0', '-rotate-45', 'w-5');
    } else {
      hamTop?.classList.remove('translate-y-0', 'rotate-45');
      hamMid?.classList.remove('opacity-0', 'scale-x-0');
      hamBot?.classList.remove('translate-y-0', '-rotate-45', 'w-5');
    }
  });
</script>