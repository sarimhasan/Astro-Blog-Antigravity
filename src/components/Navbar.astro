---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Logs',          href: '/' },
  { label: 'Journal',       href: '/journal' },
  { label: 'Philosophy',    href: '/category/philosophy' },
  { label: 'Science',       href: '/category/science' },
  { label: 'Thoughts',      href: '/category/thoughts' },
  { label: 'Miscellaneous', href: '/category/miscellaneous' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href === '/journal') return currentPath === '/journal' || currentPath.startsWith('/blog/');
  return currentPath.startsWith(href);
};
---

<!-- Fixed journal-styled navbar -->
<header class="fixed left-0 right-0 top-0 z-[90] border-b border-[var(--outline-variant)] bg-[var(--surface)] bg-opacity-95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-6 lg:px-10">

    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2 shrink-0">
      <span class="font-['Courier_Prime'] text-[1.4rem] font-bold italic text-[var(--primary)] tracking-tight">The Inkwell</span>
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Primary navigation" class="hidden items-center gap-6 lg:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            "font-['Courier_Prime'] text-[0.78rem] uppercase tracking-[0.05em] transition-colors duration-150 pb-1",
            isActive(item.href)
              ? 'border-b-2 border-[var(--primary)] text-[var(--primary)] font-bold'
              : 'text-[var(--on-surface-variant)] hover:text-[var(--primary)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      class="flex flex-col gap-1.5 p-2 lg:hidden"
    >
      <span class="block h-[1.5px] w-6 bg-[var(--primary)] transition-all duration-200" id="ham-top"></span>
      <span class="block h-[1.5px] w-6 bg-[var(--primary)] transition-all duration-200" id="ham-mid"></span>
      <span class="block h-[1.5px] w-4 bg-[var(--primary)] transition-all duration-200 self-end" id="ham-bot"></span>
    </button>
  </div>

  <!-- Mobile menu (hidden by default) -->
  <div id="mobile-menu" class="hidden border-t border-[var(--outline-variant)] bg-[var(--surface-container-low)] px-6 pb-6 pt-4 lg:hidden">
    <nav aria-label="Mobile navigation" class="flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            "font-['Courier_Prime'] text-[0.82rem] uppercase tracking-[0.05em] py-3 border-b border-[var(--outline-variant)]/30 transition-colors",
            isActive(item.href)
              ? 'text-[var(--primary)] font-bold'
              : 'text-[var(--on-surface-variant)] hover:text-[var(--primary)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('mobile-menu');
  const hamTop = document.getElementById('ham-top');
  const hamMid = document.getElementById('ham-mid');
  const hamBot = document.getElementById('ham-bot');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      hamTop?.classList.add('translate-y-2', 'rotate-45');
      hamMid?.classList.add('opacity-0');
      hamBot?.classList.add('-translate-y-2', '-rotate-45', 'w-6');
    } else {
      hamTop?.classList.remove('translate-y-2', 'rotate-45');
      hamMid?.classList.remove('opacity-0');
      hamBot?.classList.remove('-translate-y-2', '-rotate-45', 'w-6');
    }
  });
</script>