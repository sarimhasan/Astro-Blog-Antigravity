---
import Icon from './Icon.astro';
import { hueVars, categoryLabel } from '../lib/categories';
import { formatPostDate, type PostEntry } from '../lib/content';

interface Props {
  post: PostEntry;
  index: number;
}

const { post, index } = Astro.props;
---

<li class="row" style={hueVars(post.category)} data-reveal>
  <a href={`/${post.slug}`} class="row__link group">
    <span class="row__wash" aria-hidden="true"></span>

    <span class="readout row__index" aria-hidden="true">{index}</span>

    <span class="row__main">
      <span class="row__title display display-sm">{post.title}</span>
      {post.excerpt && <span class="row__excerpt">{post.excerpt}</span>}
    </span>

    <span class="row__meta">
      <span class="chip row__chip">{categoryLabel(post.category)}</span>
      <span class="readout row__date">{formatPostDate(post.date)}</span>
      <span class="readout row__time">{post.readTime}</span>
    </span>

    <span class="row__arrow" aria-hidden="true">
      <Icon name="arrow-right" size={18} strokeWidth={1.5} />
    </span>
  </a>

  {post.coverImage && (
    <span class="row__peek" aria-hidden="true">
      <img src={post.coverImage} alt="" loading="lazy" decoding="async" />
    </span>
  )}
</li>

<style>
  .row {
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .row__link {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem 1.25rem;
    padding-block: 1.75rem;
    isolation: isolate;
  }

  @media (min-width: 900px) {
    .row__link {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 2rem;
      padding-block: 2rem;
    }
  }

  /* The hue floods in from the left on hover — the same gesture as the
     section bands, at row scale. */
  .row__wash {
    position: absolute;
    inset: 0 -1.25rem;
    z-index: -1;
    border-radius: var(--r-md);
    background: linear-gradient(90deg, var(--hue-soft), transparent 70%);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .row__link:hover .row__wash,
  .row__link:focus-visible .row__wash {
    opacity: 1;
  }

  .row__index {
    padding-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-soft);
    transition: color var(--t-base) var(--ease);
  }

  .row__link:hover .row__index {
    color: var(--hue-ink);
  }

  .row__main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .row__title {
    color: var(--text);
    text-wrap: balance;
    transition: color var(--t-base) var(--ease);
  }

  .row__link:hover .row__title {
    color: var(--hue-ink);
  }

  .row__excerpt {
    color: var(--text-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 54ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    grid-column: 2 / -1;
  }

  @media (min-width: 900px) {
    .row__meta {
      grid-column: auto;
      flex-wrap: nowrap;
      justify-content: flex-end;
    }

    .row__date,
    .row__time {
      white-space: nowrap;
    }
  }

  .row__arrow {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 99px;
    border: 1px solid var(--border);
    color: var(--text-soft);
    transition:
      transform var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      background var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease);
  }

  @media (min-width: 900px) {
    .row__arrow {
      display: grid;
    }
  }

  .row__link:hover .row__arrow {
    transform: translateX(5px);
    color: var(--bg);
    background: var(--hue);
    border-color: var(--hue);
  }

  /* A small cover thumbnail that only materialises on hover, on wide
     screens, alongside the cursor. Rewards attention without adding a card. */
  /* Sits in the dead space between the excerpt and the metadata, so it
     never covers the date or the read time. */
  .row__peek {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: none;
    width: 7.5rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--r-md);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-mid);
    pointer-events: none;
    opacity: 0;
    transform: translate(0, -50%) scale(0.92) rotate(-3deg);
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .row__peek img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1200px) and (hover: hover) {
    .row__peek {
      display: block;
    }

    .row:hover .row__peek {
      opacity: 1;
      transform: translate(0, -50%) scale(1) rotate(-3deg);
    }
  }
</style>
