---
import { CATEGORIES } from '../lib/categories';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__band" aria-hidden="true">
    {
      CATEGORIES.map((c) => (
        <span
          class="foot__band-seg"
          style={`--hue: var(--cat-${c.slug}); --hue-glow: var(--cat-${c.slug}-glow);`}
        />
      ))
    }
  </div>

  <div class="shell foot__inner">
    <div class="foot__lead">
      <h2 class="display display-md foot__title">
        Still writing.<br />Still wrong about things.
      </h2>
      <p class="copy foot__copy">
        This is where I think out loud about physics, philosophy, and whatever book has hold of me
        this month. Nothing here is finished — that is rather the point.
      </p>
    </div>

    <nav class="foot__nav" aria-label="Footer">
      <span class="readout foot__nav-head">Sections</span>
      <ul class="foot__nav-list">
        <li>
          <a href="/" class="ulink foot__nav-link">Home</a>
        </li>
        {
          CATEGORIES.map((c) => (
            <li>
              <a
                href={`/category/${c.slug}`}
                class="ulink foot__nav-link"
                style={`--hue-ink: var(--cat-${c.slug}-ink);`}
              >
                {c.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/reading" class="ulink foot__nav-link">Reading</a>
        </li>
      </ul>
    </nav>

    <div class="foot__meta">
      <span class="readout foot__nav-head">Colophon</span>
      <p class="foot__meta-copy">
        Set in <strong>Anybody</strong> and <strong>Literata</strong>. Colour is wavelength — each
        section sits where it would fall in a spectrum.
      </p>
      <a href="/keystatic" class="foot__edit" data-astro-reload>
        Editor
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  </div>

  <div class="shell foot__base">
    <span class="readout">© {year} Sarim Hasan</span>
    <span class="readout">Built with Astro · Written by hand</span>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: 8rem;
    border-top: 1px solid var(--border);
    background: var(--bg-2);
  }

  /* The dispersion, laid flat across the full width — the page closes on the
     same idea it opens with. */
  .foot__band {
    position: absolute;
    inset: -1px 0 auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 3px;
  }

  .foot__band-seg {
    background: var(--hue);
  }

  .foot__inner {
    display: grid;
    gap: 3rem;
    padding-block: 4.5rem 3rem;
  }

  @media (min-width: 900px) {
    .foot__inner {
      grid-template-columns: 1.4fr 0.7fr 1fr;
      gap: 3.5rem;
      padding-block: 6rem 3.5rem;
    }
  }

  .foot__title {
    color: var(--text);
  }

  .foot__copy {
    margin-top: 1.25rem;
    max-width: 42ch;
  }

  .foot__nav-head {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--text-soft);
  }

  .foot__nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__nav-link {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text-muted);
  }

  .foot__meta-copy {
    color: var(--text-soft);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 34ch;
  }

  .foot__meta-copy strong {
    color: var(--text-muted);
    font-weight: 600;
  }

  .foot__edit {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-soft);
    transition: color var(--t-fast) var(--ease);
  }

  .foot__edit:hover {
    color: var(--text);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    padding-block: 1.5rem 2.25rem;
    border-top: 1px solid var(--border);
  }
</style>
