---

<footer class="border-t border-[var(--outline-variant)] bg-[var(--surface-container-highest)] mt-12">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-6 px-6 py-8 md:flex-row md:items-center md:justify-between md:gap-10 md:py-10 lg:px-10">

    <!-- Left: brand -->
    <div>
      <p class="font-['Courier_Prime'] text-[1.1rem] font-bold italic text-[var(--primary)]">The Inkwell</p>
      <p class="mt-1 font-['Source_Serif_4'] text-[0.82rem] text-[var(--on-surface-variant)] opacity-80">
        © 2024 The Inkwell. Written in graphite, stored in silicon.
      </p>
    </div>

    <!-- Center: nav links -->
    <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-5 gap-y-2 font-['Courier_Prime'] text-[0.72rem] uppercase tracking-[0.05em] text-[var(--on-surface-variant)]">
      <a href="/"                       class="transition-colors hover:text-[var(--primary)]">Logs</a>
      <a href="/category/philosophy"    class="transition-colors hover:text-[var(--primary)]">Philosophy</a>
      <a href="/category/science"       class="transition-colors hover:text-[var(--primary)]">Science</a>
      <a href="/category/thoughts"      class="transition-colors hover:text-[var(--primary)]">Thoughts</a>
      <a href="/category/miscellaneous" class="transition-colors hover:text-[var(--primary)]">Miscellaneous</a>
    </nav>

    <!-- Right: RSS + extras -->
    <div class="flex gap-4 font-['Courier_Prime'] text-[0.68rem] uppercase tracking-[0.05em] text-[var(--outline)]">
      <a href="#" class="transition-colors hover:text-[var(--primary)]">RSS Feed</a>
      <a href="#" class="transition-colors hover:text-[var(--primary)]">Colophon</a>
    </div>

  </div>
</footer>
