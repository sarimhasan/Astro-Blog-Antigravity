---
/**
 * The site icon set. Drawn on a 24 grid, single 1.6 stroke, round caps and
 * joins, no fills. Everything on the site that looks like an icon comes from
 * here — no emoji, no unicode arrows, no third-party set with a different
 * stroke weight.
 */

const paths = {
  'arrow-right': '<path d="M4 12h15.5"/><path d="M13.5 5.5 20 12l-6.5 6.5"/>',
  'arrow-left': '<path d="M20 12H4.5"/><path d="M10.5 18.5 4 12l6.5-6.5"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8.5 7H17v8.5"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/>',
  moon: '<path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8Z"/>',
  menu: '<path d="M3.5 7.5h17M3.5 16.5h17"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  book: '<path d="M4 4.8A1.8 1.8 0 0 1 5.8 3H19v15.5H5.8A1.8 1.8 0 0 0 4 20.3Z"/><path d="M4 20.3A1.8 1.8 0 0 1 5.8 18.5H19V21H5.8A1.8 1.8 0 0 1 4 19.2Z"/><path d="M8.5 7.5h6"/>',
  film: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M7.5 4.5v15M16.5 4.5v15M3 12h18M3 8.2h4.5M3 15.8h4.5M16.5 8.2H21M16.5 15.8H21"/>',
  prism: '<path d="M12 3.5 21 19.5H3Z"/><path d="M3.5 11h6.2"/><path d="M14.6 12.6 21 9.4M14.9 14.2 21 12.2M15.3 15.8 21 15"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
};

interface Props {
  name: keyof typeof paths;
  size?: number | string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className = '', strokeWidth = 1.6 } = Astro.props;
const d = paths[name] ?? paths.prism;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>
