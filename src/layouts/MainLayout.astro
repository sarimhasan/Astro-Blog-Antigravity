---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
}

const {
  title = 'The Inkwell',
  description = 'A quiet journal on space, physics, philosophy, and the natural world — thoughts written in graphite, stored in silicon.',
  image = '/images/hero-nocode.jpg',
  canonicalURL = Astro.url.href,
  type = 'website'
} = Astro.props;

const siteName = 'The Inkwell';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#100f0e" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta property="og:site_name" content={siteName} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body class="relative min-h-dvh overflow-x-hidden bg-[var(--bg)] text-[var(--text)] selection:bg-[rgba(201,154,86,0.2)] selection:text-white">
    <div aria-hidden="true" class="fixed inset-0 -z-20 bg-[radial-gradient(circle_at_top,_rgba(201,154,86,0.10),_transparent_38%),radial-gradient(circle_at_82%_12%,_rgba(122,158,181,0.07),_transparent_28%),linear-gradient(180deg,_#131110_0%,_#100f0e_45%,_#0c0b0a_100%)]" data-parallax="15"></div>
    <div aria-hidden="true" class="noise-overlay fixed inset-0 -z-10 pointer-events-none"></div>

    <a href="#content" class="skip-link">Skip to content</a>
    <Navbar currentPath={Astro.url.pathname} />

    <main id="content" class="mx-auto w-full max-w-[1240px] px-4 pb-16 pt-28 sm:px-6 lg:px-8 lg:pt-32">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<script>
  import '../scripts/animations.ts';
</script>

<style is:global>
  @import '../styles/global.css';
</style>
