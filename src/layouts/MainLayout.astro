---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
}

const { 
  title = 'The Inkwell', 
  description = 'Thoughts written in graphite, stored in silicon. A personal journal for essays, philosophy, and reflections.',
  image = '/images/hero-nocode.jpg',
  canonicalURL = Astro.url.href,
  type = 'website'
} = Astro.props;

const siteName = 'The Inkwell';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e8ddc5" />
    
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta property="og:site_name" content={siteName} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url).href} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-[var(--surface)] text-[var(--on-surface)] relative overflow-x-hidden selection:bg-[rgba(22,40,57,0.12)]">
    <!-- Global paper-grain overlay -->
    <div class="noise-overlay fixed inset-0 z-[100] pointer-events-none" aria-hidden="true"></div>

    <a href="#content" class="skip-link">Skip to content</a>
    <Navbar currentPath={Astro.url.pathname} />

    <!-- pt-16 = exact height of the fixed navbar -->
    <div id="content" class="mx-auto w-full max-w-[1200px] pt-16">
      <slot />
    </div>

    <Footer />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
