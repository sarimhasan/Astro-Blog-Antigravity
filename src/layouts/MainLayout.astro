---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SpectrumSpine from '../components/SpectrumSpine.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  /** Category slug — binds the page-level hue. */
  hue?: string;
  /** Identifies the page to the motion system. */
  page?: string;
}

const siteName = 'Sarim Hasan';

const {
  title = `${siteName} — physics, philosophy, and things worth rereading`,
  description =
    'Essays on physics, philosophy, and being a person — written for the version of me that did not understand it yet.',
  image = '/images/hero-nocode.jpg',
  canonicalURL = Astro.url.href,
  type = 'website',
  hue,
  page = 'generic'
} = Astro.props;

const directionContract = `<!--
THESIS: A physics blog does not have to look like space; it can look like light itself. Every colour on this site is a wavelength, and category is position on the spectrum. Refuses the near-black-plus-one-neon-accent default and the cream-paper-serif blog default alike.
OWN-WORLD: Ink-indigo ground (never black), four spectral hues owning whole regions rather than accenting them, Anybody variable-width display, Literata prose, and nothing else — no monospace costume for metadata. Instrument language — ticked rules, wavelength readouts, dispersion diagrams — carries the physics without a single planet or star.
STORY: A reader arrives, sees a headline breathing over a live interference field, understands within seconds that this is a writer worth reading, and follows a hue into an essay.
FIRST VIEWPORT: A full-viewport plate — live two-source interference canvas behind, a readout rail under the nav, an enormous Anybody headline whose width axis is scrubbed by scroll, the spectrum spine pinned to the left edge, and the four wavelengths closing the bottom edge. The featured essay is the first thing below the fold.
FORM: Replacement world, direction spectral-editorial, pinned by the user's brief (cosmic editorial, dark-first, bold geometric display, showcase motion) rather than dealt.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`;

const ogImage = new URL(image, Astro.url).href;
---

<!DOCTYPE html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08060f" id="theme-color-meta" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preload" href="/fonts/anybody-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata-var.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    <!-- Theme resolved before first paint so there is never a flash of the
         wrong ground. Dark is the default; the toggle persists an override. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch {
          /* private mode — dark default is already correct */
        }
        // Reveal targets are only hidden once we know JS is running and the
        // visitor has not asked for reduced motion. No script, no blank page.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion-ready');
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body>
    <Fragment set:html={directionContract} />

    <a href="#content" class="skip-link">Skip to content</a>

    <div class="grain" aria-hidden="true"></div>
    <SpectrumSpine />

    <div class="cursor-lens" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>

    <Navbar currentPath={Astro.url.pathname} />

    <!-- ScrollSmoother requires exactly this wrapper/content pair. Fixed
         chrome (nav, spine, cursor, grain) stays outside it. -->
    <div id="smooth-wrapper">
      <div id="smooth-content" style={hue ? `--hue: var(--cat-${hue}); --hue-ink: var(--cat-${hue}-ink); --hue-soft: var(--cat-${hue}-soft); --hue-glow: var(--cat-${hue}-glow);` : undefined}>
        <main id="content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
